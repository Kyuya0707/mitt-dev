datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentStatus {
  PAID
  REFUNDED
}

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReportReason {
  SPAM
  ABUSE
  AI_CONTENT
  FALSE_INFORMATION
}

enum CancellationRequestStatus {
  pending
  approved
  rejected
}

model User {
  id                 String   @id
  email              String   @unique
  displayId          String?  @unique
  username           String?  @unique
  name               String?
  createdAt          DateTime @default(now())
  interestCategories String[] @default([])
  ageGroup           String?
  gender             String?

  consentAt DateTime?

  ppConsentAt                            DateTime?
  ppConsentVersion                       String?
  stripeAccountId                        String?   @unique
  stripeConnectOnboardingCompleted       Boolean   @default(false)
  stripeConnectChargesEnabled            Boolean   @default(false)
  stripeConnectPayoutsEnabled            Boolean   @default(false)
  stripeConnectDetailsSubmitted          Boolean   @default(false)
  stripeConnectRequirementsCurrentlyDue  Json?
  stripeConnectRequirementsEventuallyDue Json?
  stripeConnectDisabledReason            String?

  trustScore Int    @default(50)
  rank       String @default("WHITE")

  questions                    Question[]
  answers                      Answer[]
  purchases                    Purchase[]
  payouts                      Payout[]
  bestViewPayouts              BestViewPayout[]      @relation("BestViewPayoutRecipientUser")
  cancellationRequests         CancellationRequest[] @relation("CancellationRequester")
  reviewedCancellationRequests CancellationRequest[] @relation("CancellationReviewer")

  readAnswers            AnswerRead[]
  comments               Comment[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  answerLikes AnswerLike[]
  reports     Report[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  questions Question[]
}

model Question {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  answers Answer[]

  images QuestionImage[]

  bestAnswerId String?

  isClosed Boolean @default(false)

  rewardAmount Int

  viewerPrice Int?

  boostCount Int @default(0)

  answerDeadline DateTime?
  deadlineAt     DateTime?

  purchases Purchase[]
  payouts   Payout[]

  negotiations Negotiation[]

  reports Report[]

  cancellationRequests CancellationRequest[]

  isPaid Boolean @default(false)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([categoryId, createdAt])
  @@index([isPaid, createdAt])
  @@index([bestAnswerId])
  @@index([answerDeadline])
  @@index([isClosed, answerDeadline])
}

model Answer {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  pitch String?

  question   Question @relation(fields: [questionId], references: [id])
  questionId String

  userId String? @db.Text
  user   User?   @relation(fields: [userId], references: [id])

  likeCount Int @default(0)

  images AnswerImage[]

  reads AnswerRead[]

  comments Comment[]

  likes AnswerLike[]

  negotiation Negotiation?

  reports Report[]
  payouts Payout[] @relation("AnswerPayouts")

  @@index([questionId, createdAt])
  @@index([userId, createdAt])
}

model AnswerLike {
  userId    String
  answerId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  answer Answer @relation(fields: [answerId], references: [id])

  @@id([userId, answerId])
}

model QuestionImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id])
  questionId String

  url       String
  sortOrder Int
}

model AnswerImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  answer   Answer @relation(fields: [answerId], references: [id])
  answerId String

  url       String
  sortOrder Int    @default(0)
}

model AnswerRead {
  id       String   @id @default(cuid())
  userId   String
  answerId String
  readAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  answer Answer @relation(fields: [answerId], references: [id])

  @@unique([userId, answerId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Negotiation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  answerId String @unique

  proposedAmount Int

  expectedDays Int?

  status NegotiationStatus @default(PENDING)

  payout Payout? @relation("NegotiationPayout")

  answer Answer @relation(fields: [answerId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@index([questionId, status])
}

model Purchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  question   Question @relation(fields: [questionId], references: [id])
  questionId String

  amount Int

  currency String @default("jpy")

  stripeSessionId String? @unique
  stripeChargeId  String?
  transferGroup   String?

  status PaymentStatus @default(PAID)

  bestViewRevenueShare BestViewRevenueShare?

  @@index([userId, createdAt])
  @@index([userId, questionId, status])
  @@index([stripeChargeId])
  @@index([transferGroup])
}

model BestViewRevenueShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  questionId String
  answerId   String
  buyerId    String

  questionOwnerId String
  answerOwnerId   String

  grossAmount         Int
  questionOwnerAmount Int
  answerOwnerAmount   Int
  platformFeeAmount   Int

  currency String @default("jpy")
  status   String @default("pending")

  payouts BestViewPayout[]
}

model BestViewPayout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revenueShareId String
  revenueShare   BestViewRevenueShare @relation(fields: [revenueShareId], references: [id])

  recipientUserId String
  recipientUser   User   @relation("BestViewPayoutRecipientUser", fields: [recipientUserId], references: [id])

  recipientType String

  amount   Int
  currency String @default("jpy")

  status String @default("pending")

  stripeAccountId  String?
  stripeChargeId   String?
  transferGroup    String?
  stripeTransferId String?   @unique
  transferredAt    DateTime?
  failureReason    String?

  @@unique([revenueShareId, recipientType])
  @@index([stripeChargeId])
  @@index([transferGroup])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  message   String
  url       String?
  data      Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailOnAnswerCreated           Boolean @default(true)
  emailOnCommentCreated          Boolean @default(true)
  emailOnBestSelected            Boolean @default(true)
  emailOnNegotiationCreated      Boolean @default(true)
  emailOnNegotiationAccepted     Boolean @default(true)
  emailOnNegotiationRejected     Boolean @default(true)
  emailOnCategoryQuestionCreated Boolean @default(true)
  emailOnLogin                   Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

model Payout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id])

  answerId String?
  answer   Answer? @relation("AnswerPayouts", fields: [answerId], references: [id])

  kind String @default("question_reward")

  negotiationId String?      @unique
  negotiation   Negotiation? @relation("NegotiationPayout", fields: [negotiationId], references: [id])

  description String?

  grossAmount       Int?
  platformFeeAmount Int?
  netAmount         Int?
  amount            Int
  currency          String    @default("jpy")
  status            String
  stripeAccountId   String?
  stripeChargeId    String?
  transferGroup     String?
  stripeTransferId  String?   @unique
  transferredAt     DateTime?
  failureReason     String?

  @@unique([answerId, kind])
  @@index([stripeChargeId])
  @@index([transferGroup])
}

model CancellationRequest {
  id              String                    @id @default(cuid())
  questionId      String
  requesterUserId String
  status          CancellationRequestStatus @default(pending)
  reason          String?
  adminNote       String?
  stripeRefundId  String?
  requestedAt     DateTime                  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  requester  User     @relation("CancellationRequester", fields: [requesterUserId], references: [id])
  reviewedBy User?    @relation("CancellationReviewer", fields: [reviewedById], references: [id])

  @@index([questionId])
  @@index([requesterUserId])
  @@index([status])
}

model EventLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  payload   Json
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  reason ReportReason

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  answerId String?
  answer   Answer? @relation(fields: [answerId], references: [id])

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id])
}
